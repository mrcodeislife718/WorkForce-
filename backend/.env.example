NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb

DB_HOST=localhost
DB_PORT=5432
DB_NAME=orca_store
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_SYNC_MODE=alter
RUN_LEGACY_MIGRATIONS=true

JWT_SECRET=
ORCA_CREDENTIAL_ENCRYPTION_KEY=
ORCA_CREDENTIAL_KEY_VERSION=1

CONNECTOR_REQUEST_TIMEOUT_MS=30000
CONNECTOR_MAX_RESPONSE_BYTES=5242880
TELEMETRY_STORE_SUMMARIES=false

# Optional. Only set these to create or update the local seed administrator.
SEED_ADMIN_EMAIL=dev@orca.com
SEED_ADMIN_PASSWORD=
