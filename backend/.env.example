NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb

DB_HOST=localhost
DB_PORT=5432
DB_NAME=orca_store
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_SYNC_MODE=alter
RUN_LEGACY_MIGRATIONS=true

JWT_SECRET=
ORCA_CREDENTIAL_ENCRYPTION_KEY=
ORCA_CREDENTIAL_KEY_VERSION=1

# Real model provider. ORCA does not use a fallback or simulated response.
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_MAX_RESPONSE_BYTES=2097152
SAMPLE_MAX_TOKENS=3000
RUNTIME_PLAN_MAX_TOKENS=1800

# Real Stripe billing. Leave empty only when every published digital employee is free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CUSTOMER_SUPPORT=
STRIPE_PRICE_FOUNDER_ASSISTANT=
STRIPE_PRICE_COMMERCE_SUPPORT=
STRIPE_PRICE_SALES_FOLLOW_UP=
STRIPE_PRICE_CONTENT_PRODUCTION=

CONNECTOR_REQUEST_TIMEOUT_MS=30000
CONNECTOR_MAX_RESPONSE_BYTES=5242880
TELEMETRY_STORE_SUMMARIES=false

RUNTIME_POLL_INTERVAL_MS=2000
RUNTIME_JOB_BATCH_SIZE=5
RUNTIME_TASK_MAX_ATTEMPTS=5
SAMPLE_MAX_ATTEMPTS=3
HEALTH_CHECK_INTERVAL_MS=300000

# Optional. Only set these to create or update the local seed administrator.
SEED_ADMIN_EMAIL=dev@orca.com
SEED_ADMIN_PASSWORD=
